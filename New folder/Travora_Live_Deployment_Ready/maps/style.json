{
  "version": 8,
  "name": "Travora West Maharashtra Offline",
  "sources": {
    "travora": {
      "type": "vector",
      "url": "pmtiles://./travora-west.pmtiles"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f3f0e9"
      }
    },
    {
      "id": "land",
      "type": "fill",
      "source": "travora",
      "source-layer": "land",
      "paint": {
        "fill-color": "#f3f0e9"
      }
    },
    {
      "id": "ocean",
      "type": "fill",
      "source": "travora",
      "source-layer": "ocean",
      "paint": {
        "fill-color": "#a9d5e5"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "travora",
      "source-layer": "water_polygons",
      "paint": {
        "fill-color": "#a9d5e5"
      }
    },
    {
      "id": "boundaries",
      "type": "line",
      "source": "travora",
      "source-layer": "boundaries",
      "paint": {
        "line-color": "#9b7aa5",
        "line-width": 1.2,
        "line-opacity": 0.7
      }
    },
    {
      "id": "streets-low",
      "type": "line",
      "source": "travora",
      "source-layer": "streets",
      "minzoom": 5,
      "maxzoom": 10,
      "paint": {
        "line-color": "#d8d5cf",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          5,
          0.5,
          10,
          1.5
        ]
      }
    },
    {
      "id": "streets-med",
      "type": "line",
      "source": "travora",
      "source-layer": "streets",
      "minzoom": 10,
      "maxzoom": 13,
      "paint": {
        "line-color": [
          "match",
          [
            "get",
            "kind"
          ],
          [
            "motorway"
          ],
          "#e46f88",
          [
            "trunk",
            "primary"
          ],
          "#f0b96d",
          [
            "secondary"
          ],
          "#f5d28f",
          "#d2d0cc"
        ],
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          1,
          13,
          3
        ]
      }
    },
    {
      "id": "streets-high",
      "type": "line",
      "source": "travora",
      "source-layer": "streets",
      "minzoom": 13,
      "paint": {
        "line-color": [
          "match",
          [
            "get",
            "kind"
          ],
          [
            "motorway"
          ],
          "#d95878",
          [
            "trunk",
            "primary"
          ],
          "#e7a34e",
          [
            "secondary",
            "tertiary"
          ],
          "#e8c477",
          "#cfcac2"
        ],
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          13,
          1.5,
          14,
          4
        ]
      }
    },
    {
      "id": "bridges",
      "type": "line",
      "source": "travora",
      "source-layer": "bridges",
      "minzoom": 12,
      "paint": {
        "line-color": "#d5d1ca",
        "line-width": 2
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "travora",
      "source-layer": "buildings",
      "minzoom": 14,
      "paint": {
        "fill-color": "#d8d0c8",
        "fill-opacity": 0.8,
        "fill-outline-color": "#c1bbb3"
      }
    },
    {
      "id": "place-labels",
      "type": "symbol",
      "source": "travora",
      "source-layer": "place_labels",
      "minzoom": 8,
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          11,
          14,
          16
        ],
        "text-anchor": "center",
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "#24352f",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    }
  ]
}